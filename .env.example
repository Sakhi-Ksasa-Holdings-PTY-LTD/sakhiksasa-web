# Sakhi'ksasa Holdings website — environment variables

# The website itself is static + doesn't require any env vars to run.
# These are optional — used for future integrations.

# Port (optional — default 3001)
PORT=3001

# Analytics (optional — when you want to enable Sentry)
# SENTRY_DSN=

# The website references Standpoint + the Fleet via hardcoded URLs
# in src/config/company.ts. If those URLs change, update them there.
