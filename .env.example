# Sakhi'ksasa Holdings website — environment variables

# Port (optional — default 3001)
PORT=3001

# ---- Contact / SLA system ----
# Brevo account (from the Standpoint deployment — same account works here).
# Without these the contact form still logs enquiries, but no emails go out.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=hello@sakhiksasa.co.za   (must be a Brevo-verified sender)
# BREVO_SENDER_NAME=Sakhi'ksasa Holdings

# Where the enquiry log is reviewed daily (SLA: reply within one business day):
#   https://<site>/admin/log?key=<ADMIN_VIEW_KEY>
# ADMIN_VIEW_KEY=choose-a-long-private-string

# Canonical site URL (used in outbound email footers/links)
# SITE_BASE_URL=https://sakhiksasa-web.onrender.com

# Where staff enquiries are forwarded (defaults to the Gmail inbox)
# COMPANY_CONTACT_EMAIL=sakhiksasaholdingsptyltd@gmail.com
